# Public site URL used by canonical URLs and origin checks.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Contact form / email delivery
CONTACT_EMAIL=
EMAIL_FROM=
EMAIL_PROVIDER=resend
RESEND_KEY=

# Storage provider. Production uses the D1 binding configured in wrangler.jsonc.
STORAGE_PROVIDER=d1

# x402 payment configuration (non-secret defaults are also defined in code/Wrangler).
X402_NETWORK=eip155:84532
X402_PRICE=\$0.01
X402_FACILITATOR_URL=https://facilitator.payai.network
X402_PAY_TO_ADDRESS=

# Optional integrations
BRAVE_REWARDS_VERIFICATION_TOKEN=
WEB_MONETIZATION_PAYMENT_POINTER=
GITHUB_TOKEN=

# Optional Web Bot Authentication signing key. Never commit a real private key.
WEB_BOT_AUTH_PRIVATE_KEY=
